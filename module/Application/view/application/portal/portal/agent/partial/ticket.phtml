                    <span><?= date("d M Y", strtotime($ticket['dateCreated'])) ?></span>
                </div>
                <div class="dashboard__ticket-agents">
                    <?php foreach ($ticket['replies'] as $reply) : ?>
                        <?php if ($reply['sender']['userTypeId'] === 3
                            && !in_array($reply['sender']['userId'], $recentAgents)) :
                            $recentAgents[$reply['sender']['userId']] = $reply['sender']; ?>
                        <?php endif; ?>
                    <?php endforeach; ?>
                    <h4>Recent Agent (s)</h4>
                    <?php if (count($recentAgents)) : ?>
                        <?php foreach ($recentAgents as $agent) : ?>
                            <div class="dashboard__ticket-agent">
                                <span class="dashboard__ticket-agent--name"><?= $agent['firstName'] . $agent['lastName']; ?></span>
                                <span class="dashboard__ticket-agent--email"><?= $agent['email'] ?></span>
                            </div>
                        <?php endforeach; ?>
                    <?php else: ?>
                        <div class="dashboard__ticket-agent">
                            <span class="dashboard__ticket-agent--name">None</span>
                        </div>
