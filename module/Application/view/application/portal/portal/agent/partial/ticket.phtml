            <div class="dashboard__tab-content" data-tab="replies">
                <?php if ($countReplies) :
                    $dateList = [];
                    ?>
                    <div class="dashboard__reply-collection">
                        <?php foreach ($ticket['replies'] as $reply) :
                            $isYou = $reply['sender']['userId'] === $userId;
                            $class = $isYou ? '--right' : '--left';
                            $displayName = $isYou ? 'You' : $reply['sender']['firstName'];
                            $date = date("d M Y", strtotime($reply['dateCreated'])); ?>
                            <?php if (!in_array($date, $dateList)) :
                            $dateList[] = $date; ?>
                            <div class="dashboard__reply">
                                <div class="dashboard__reply-date"><?= $date ?></div>
                            </div>
                        <?php endif; ?>
                            <div class="dashboard__reply dashboard__reply<?= $class ?>">
                                <div class="dashboard__reply-sender">
                                    <span class="dashboard__reply-sender--type"><?= $reply['userTypeId']['userTypeName']; ?></span>
                                    <span class="dashboard__reply-sender--name"><?= $displayName ?></span>
                                </div>
                                <div class="dashboard__reply-bubble">
                                    <?= $reply['message'] ?>
                                </div>
                                <div class="dashboard__reply-time"><?= date("H:i a",
                                                                            strtotime($reply['dateCreated'])) ?></div>
                            </div>
                        <?php endforeach; ?>
